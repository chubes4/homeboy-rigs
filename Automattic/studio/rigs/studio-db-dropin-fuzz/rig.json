{
  "id": "studio-db-dropin-fuzz",
  "description": "Isolated filesystem state-machine fuzzing for Studio SQLite db.php classification and installation.",
  "components": {
    "studio": {
      "component_id": "studio",
      "default_ref": "origin/trunk",
      "path": "${env.HOMEBOY_RIG_COMPONENT_PATH__STUDIO_DB_DROPIN_FUZZ__STUDIO}",
      "path_setting": "HOMEBOY_RIG_COMPONENT_PATH__STUDIO_DB_DROPIN_FUZZ__STUDIO",
      "extensions": {
        "nodejs": {}
      }
    }
  },
  "resources": {
    "paths": [
      "${components.studio.path}"
    ]
  },
  "requirements": {
    "dependency_materialization": [
      {
        "id": "studio-cli-fuzz-dependencies",
        "command": "npm ci --ignore-scripts && npm run cli:build",
        "component": "studio",
        "cwd": "${components.studio.path}",
        "inputs": {
          "manifest": "${components.studio.path}/package.json",
          "lockfile": "${components.studio.path}/package-lock.json"
        },
        "expected_outputs": [
          {
            "path": "${components.studio.path}/node_modules/tar",
            "kind": "dir"
          },
          {
            "path": "${components.studio.path}/apps/cli/dist/cli/main.mjs",
            "kind": "file"
          }
        ],
        "cache_key_inputs": [
          "${components.studio.path}/package.json",
          "${components.studio.path}/package-lock.json",
          "${components.studio.path}/apps/cli/package.json"
        ],
        "safety": "network_access"
      }
    ]
  },
  "fuzz": {
    "default_component": "studio"
  },
  "fuzz_workloads": {
    "nodejs": [
      {
        "path": "${package.root}/fuzz/db-dropin-state-machine-fuzz.json"
      },
      {
        "path": "${package.root}/fuzz/import-db-dropin-pr-4356-fuzz.json"
      }
    ]
  },
  "fuzz_profiles": {
    "provider": [
      "db-dropin-state-machine-fuzz"
    ],
    "pr-4356": [
      "import-db-dropin-pr-4356-fuzz"
    ]
  },
  "pipeline": {
    "check": [
      {
        "kind": "check",
        "label": "Studio db.php fuzz workload manifest exists",
        "file": "${package.root}/fuzz/db-dropin-state-machine-fuzz.json"
      },
      {
        "kind": "check",
        "label": "Studio db.php fuzz runner exists",
        "file": "${package.root}/fuzz/db-dropin-fuzz-runner.mjs"
      },
      {
        "kind": "check",
        "label": "Studio import-boundary fuzz runner exists",
        "file": "${package.root}/fuzz/import-db-dropin-fuzz-runner.mjs"
      },
      {
        "kind": "check",
        "label": "Studio SQLite integration source exists",
        "file": "${components.studio.path}/packages/common/lib/sqlite-integration.ts"
      }
    ],
    "fuzz_prepare": [
      {
        "kind": "requirement",
        "id": "studio-cli-fuzz-runtime-ready",
        "file": "${components.studio.path}/apps/cli/dist/cli/main.mjs",
        "label": "Studio CLI fuzz runtime is built"
      }
    ],
    "down": []
  }
}
