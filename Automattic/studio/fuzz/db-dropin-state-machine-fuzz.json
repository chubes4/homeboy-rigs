      "level": "executable",
      "coverage_contract": "The runner executes all declared operations against the selected Studio checkout and emits replayable case and dimension coverage evidence.",
      "upstream_blockers": [
        "Attach a reviewer-facing Homeboy run before promoting readiness to proven."
      ]
    },
    "dimensions": [
      "destination-artifact-combinations",
      "dropin-content-spoofing",
      "custom-dropin-preservation",
      "filesystem-blocker-recovery",
      "symlink-containment",
      "intentional-mysql-non-mutation"
    ]
  },
  "target": {
    "type": "typescript-class",
    "slug": "sqlite-integration-provider",
    "component": "studio"
  },
  "workload": {
    "runner": "nodejs",
    "type": "module",
    "path": "${package.root}/fuzz/db-dropin-fuzz-runner.mjs",
    "entry": "main"
  },
  "cases": [
    {
      "case_id": "db-dropin-state-machine-fuzz:campaign",
      "surface_ids": [
        "studio-sqlite-dropin-filesystem"
      ],
      "operations": [
        "sqlite.destination.classify",
